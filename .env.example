# Copy to /opt/product-evaluation/.env ON THE SERVER. Never commit real keys.
# Cloud: retain the existing GLM gateway, model ID and key from the server .env.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://onerouter.cmaiot.cn/v1
# Fill the exact existing GLM model ID; Compose refuses a blank model.
LLM_MODEL=
# Optional separate report model; blank uses LLM_MODEL.
LLM_REPORT_MODEL=

# Local: run_local.py defaults LLM_PROVIDER to gemini. Keep local keys separate.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REPORT_MODEL=

# Host port, bound to 127.0.0.1. Use the company reverse proxy for user access.
PRODUCT_EVAL_PORT=8765

# The deployment script manages the production image in image.env separately.
# For a manual first launch, build this local image or supply a GHCR image ref.
PRODUCT_EVAL_IMAGE=product-evaluation:local
